{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "pnpm --filter @coasterly/web build",
    "watchPatterns": [
      "/apps/web/**",
      "/packages/types/**",
      "/package.json",
      "/pnpm-lock.yaml",
      "/tsconfig.base.json"
    ]
  },
  "deploy": {
    "startCommand": "node node_modules/serve/build/main.js -s apps/web/dist -l tcp://0.0.0.0:$PORT",
    "healthcheckPath": "/",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
