{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "buildCommand": "pnpm --filter @coasterly/catalog-import build",
    "watchPatterns": [
      "/apps/catalog-import/**",
      "/apps/api/src/db.ts",
      "/apps/api/src/services/catalog-import.ts",
      "/apps/api/src/integrations/queue-times.ts",
      "/packages/types/**",
      "/package.json",
      "/pnpm-lock.yaml",
      "/tsconfig.base.json"
    ]
  },
  "deploy": {
    "startCommand": "node apps/catalog-import/dist/index.js",
    "restartPolicyType": "NEVER"
  }
}
